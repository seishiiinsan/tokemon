{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "hooks/**",
      "scripts/**",
      "tests/**",
      "*.json",
      "!hooks/data/frames.gen1.js",
      "!hooks/data/species.js",
      "!hooks/data/evolutions.js"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": { "noUndeclaredVariables": "error", "noUnusedVariables": "error", "noUnusedImports": "error" },
      "complexity": { "useOptionalChain": "off" },
      "style": { "useTemplate": "off", "noParameterAssign": "off" },
      "suspicious": { "noAssignInExpressions": "off" }
    }
  }
}
